# Every setting of the project, at its default value.
#
# Copy this file to .env (kept out of git) and change what you need there. An environment
# variable of the same name wins over .env, so Docker and Kubernetes can set them too:
#   docker run --env-file .env -p 8000:8000 product-similarity
# Settings are read when Python starts: restart the API, or rerun the command, after a change.
# Comments go on lines of their own; a # after a value would become part of the value.
# Details: similarity/config.py

# ---- The API: what it searches with ------------------------------------------------------

# Which score: tfidf, minilm, tfidf_image or minilm_image (compared in README.md, Experiments and results).
# tfidf needs nothing extra. minilm needs data/processed/title_embeddings.npz (python -m similarity.embeddings).
# The image methods also need data/processed/image_embeddings.npz (python -m similarity.images embed).
SIMILARITY_METHOD=tfidf

# How the products are found: exact (score every product) or ann (an HNSW shortlist, then the same
# score on it; stage 8). ann needs faiss-cpu and the index (python -m similarity.ann build).
SEARCH_MODE=exact

# The most products a caller may ask for; also how many are kept per product in the cache.
MAX_SIMILAR=100

# How many products' results the API keeps in memory (0 turns the cache off).
CACHE_SIZE=1024

# ---- The score: how much each attribute counts ----------------------------------------------
# A pair is judged only on the attributes both products have, so these need not add up to 1.
# After changing any of them, rebuild the ANN index if you use it (python -m similarity.ann build).

WEIGHT_TEXT=0.30
WEIGHT_CATEGORY=0.20
WEIGHT_GENDER=0.10
WEIGHT_PRICE=0.15
WEIGHT_BRAND=0.15
WEIGHT_COLOUR=0.05
WEIGHT_WEIGHT=0.05

# The photo score, added on top in tfidf_image and minilm_image.
WEIGHT_IMAGE=0.20

# Scores are rounded to this many decimals before sorting; equal scores are then ordered by rating.
SCORE_DECIMALS=3

# ---- ANN search (stage 8; only used when SEARCH_MODE=ann) -----------------------------------

# Products shortlisted by HNSW and then scored exactly. More: closer to exact search, slower.
ANN_CANDIDATES=1000

# Building the index: links per product, and candidates weighed per link.
# Change these, then run python -m similarity.ann build again.
ANN_M=64
ANN_EF_CONSTRUCTION=500

# ---- Files (relative to the repo root; ~ is your home folder) --------------------------------

RAW_DATA_PATH=data/archive/marketing_sample_for_amazon_com-amazon_fashion_products__20200201_20200430__30k_data.ldjson
PRODUCTS_PATH=data/processed/products.parquet
TITLE_EMBEDDINGS_PATH=data/processed/title_embeddings.npz
IMAGE_EMBEDDINGS_PATH=data/processed/image_embeddings.npz
ANN_INDEX_PATH=data/processed/product_hnsw.faiss

# The product photos (stage 7), kept outside the repo because it syncs to OneDrive.
IMAGE_DIR=~/Downloads/Amazon Image Download

# ---- The offline steps (stages 6 and 7) -------------------------------------------------------
# Changing a model means encoding again (python -m similarity.embeddings / similarity.images embed).

TITLE_MODEL=sentence-transformers/all-MiniLM-L6-v2
IMAGE_MODEL=sentence-transformers/clip-ViT-B-32

# CPU threads for encoding titles.
ENCODE_THREADS=4

# Photos downloaded at the same time, and seconds to wait for each.
DOWNLOAD_WORKERS=8
DOWNLOAD_TIMEOUT=10
